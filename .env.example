# Copy this file to .env and replace the values. Keep .env out of version control.
GEMINI_API_KEY=
PEXELS_API_KEY=

# Required for uploads. Obtain this OAuth client JSON from Google Cloud Console.
# The local default path is configured in config.yaml.
YOUTUBE_OAUTH_CLIENT_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# Set to 0 in GitHub Actions to forbid an interactive browser login.
YOUTUBE_INTERACTIVE_LOGIN=1
